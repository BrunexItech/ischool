# Read by docker-compose.prod.yml itself (not by the app containers).
# Copy to .env on the VPS, next to docker-compose.prod.yml, and fill in.

POSTGRES_PASSWORD=
# The one hostname this deployment serves. Individual schools are NOT
# sub-subdomains of this (no wildcard DNS needed) — they're told apart by
# the ?school= query param or their own custom_domain if they bring one.
APP_DOMAIN=ischool.oqtekal.com
