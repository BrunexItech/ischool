# Copy to backend/.env.production on the VPS and fill in every value below.
# DATABASE_URL is set by docker-compose.prod.yml itself — don't duplicate it here.

SECRET_KEY=
ACCESS_TOKEN_EXPIRE_MINUTES=1440
CORS_ORIGINS=["https://ischool.oqtekal.com"]
FRONTEND_URL=https://ischool.oqtekal.com
BACKEND_URL=https://ischool.oqtekal.com/api

# Must match the keys: entry in livekit.prod.yaml exactly.
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=
LIVEKIT_URL=wss://ischool.oqtekal.com/livekit

SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=iSchool <your-address@gmail.com>

# Generate with: python3 -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
ENCRYPTION_KEY=

ENVIRONMENT=production
# Optional — leave blank until you have a Sentry project; the app runs fine without it.
SENTRY_DSN=
